{
  "name": "cci-website",
  "version": "1.0.0",
  "private": true,
  "description": "Crafts Council of India website — Next.js + PostgreSQL CMS",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "npm run assets:sync && next dev",
    "build": "npm run assets:sync && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "assets:sync": "node scripts/sync-legacy-assets.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "import:legacy": "tsx scripts/import-legacy-content/index.ts",
    "import:validate": "tsx scripts/import-legacy-content/validate.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "audit:assets": "node scripts/audit/build-asset-manifest.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/petit-formal-script": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.8",
    "next": "^16.4.1",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.30",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
