# Copy to .env and fill in. Never commit real values.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cci"

# Public base URL (no trailing slash). Used for canonical URLs, sitemap and JSON-LD.
SITE_URL="https://www.craftscouncilofindia.in"
# production | staging | development — only "production" allows search engines (robots.txt, meta robots).
SITE_ENV="development"

# Admin sessions
SESSION_TTL_HOURS="12"
# Defaults to secure cookies when NODE_ENV=production. Set "false" only for local http testing.
SESSION_COOKIE_SECURE=""
# "true" only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY="false"

# Media uploads (local storage driver). Must be a persistent volume in production.
UPLOAD_DIR="./storage/uploads"
UPLOAD_MAX_BYTES="26214400"

# Google reCAPTCHA v2 (checkbox) — contact form
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# SMTP (ZeptoMail: host smtp.zeptomail.com, user "emailapikey", password = Send Mail token)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Crafts Council Of India <noreply@craftscouncilofindia.in>"

# Optional: path to the legacy static site used by the importer and asset sync
LEGACY_ROOT="_public_html"
